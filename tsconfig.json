{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "./backend/node_modules/@types"
    ]
  },
  "include": [
    "database/**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ]
}
